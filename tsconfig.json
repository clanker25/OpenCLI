{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": false,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": false,
    "declaration": true,
    "incremental": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "extension"]
}
